  .hero-tagline-small { font-size: 10px; letter-spacing: 1.5px; margin-bottom: 8px; }
  .hero-name-big { font-size: clamp(38px, 10.5vw, 56px); margin-bottom: 4px; letter-spacing: -1.5px; }
