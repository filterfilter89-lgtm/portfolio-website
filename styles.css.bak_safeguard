  .portfolio-copy h3 br { display: none; }
  .portfolio-copy h3 em::before { content: ' '; }
  .album-cta { font-size: 11px; width: 100%; justify-content: space-between; }
  .about-section { grid-template-columns: 1fr; gap: 20px; padding-block: 45px 50px; }
  .about-copy h2 { margin-top: 18px; }
  .about-copy p { font-size: 13px; margin: 20px 0 16px; }
  .about-location { font-size: 8px; }
  .about-details { padding-top: 10px; }
  .about-details summary { font-size: 13px; padding-block: 18px; }
  .contact-inner { padding-block: 45px; }
  .contact-section h2 { font-size: clamp(57px, 10vw, 75px); letter-spacing: -1.5px; margin-block: 22px; }
  .contact-email { font-size: 13px; gap: 12px; }
  .email-row { gap: 10px; }
