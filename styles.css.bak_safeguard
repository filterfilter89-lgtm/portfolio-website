/* ============================================================
   DRAGGABLE AIRMAIL POSTCARDS WITH 1:1 3D FLIP & 16:9 EXPAND
   ============================================================ */

.scattered-envelopes-wrapper {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: visible;
  z-index: 15;

  perspective: 2000px;
  transform-style: preserve-3d;}

.scattered-envelopes-wrapper.album-descended {
  z-index: 35;
  pointer-events: auto;
}

.draggable-postcard-item {
  position: absolute;
  left: var(--card-left);
  top: var(--card-top);
  width: 330px;
  height: 210px;
  z-index: var(--z-order, 10);
  cursor: grab;
  outline: none;
  perspective: 1200px;
  transform-style: preserve-3d;
  touch-action: none;
  pointer-events: auto;
}

.draggable-postcard-item:active,
.draggable-postcard-item.is-dragging {
  cursor: grabbing !important;
  z-index: 125 !important;
}

.draggable-postcard-item.is-dragging .postcard-3d-flipper {
  transform: scale(1.05) rotate(-1.5deg) !important;
  box-shadow: 0 35px 70px rgba(0, 10, 35, 0.52), 0 10px 24px rgba(0, 0, 0, 0.24);
}

.draggable-postcard-item:hover:not(.is-dragging):not(.is-flipping):not(.is-expanded) .postcard-3d-flipper {
  transform: translateY(-6px) scale(1.025);
}

/* 3D Double-Sided Flipper (Strict 1:1 Scale Flip) */
.postcard-3d-flipper {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease;
  border-radius: 4px;
  box-shadow: 
    0 16px 36px rgba(0, 15, 40, 0.34),
    0 4px 12px rgba(0, 0, 0, 0.16);
}

.postcard-3d-flipper.is-flipped {
  transform: rotateY(180deg);
}

.postcard-side {
  position: absolute;
  inset: 0;
  border-radius: 4px;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  overflow: hidden;
}

.postcard-side-front {
  z-index: 2;
  transform: rotateY(0deg);
}

.postcard-side-back {
  z-index: 1;
  transform: rotateY(180deg);
  background: var(--cream, #fff7ed);
}

