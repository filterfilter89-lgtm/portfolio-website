:root {
  --blue: #285991;
  --cream: #FFF7ED;
  --blue-dark: color-mix(in srgb, var(--blue) 72%, black);
  --blue-mid: color-mix(in srgb, var(--blue) 83%, var(--cream));
  --blue-light: color-mix(in srgb, var(--blue) 18%, var(--cream));
  --blue-pale: color-mix(in srgb, var(--blue) 7%, var(--cream));
  --cream-shade: color-mix(in srgb, var(--cream) 93%, black);
  --line: color-mix(in srgb, var(--blue) 22%, transparent);
  --shadow: color-mix(in srgb, var(--blue-dark) 18%, transparent);
  --serif: 'Instrument Serif', Georgia, serif;
  --sans: 'DM Sans', sans-serif;
  --mono: 'Space Mono', monospace;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 35px; }
body { margin: 0; background: var(--cream); color: var(--blue); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
a { color: inherit; text-decoration: none; }
button { font: inherit; color: inherit; cursor: pointer; border: 0; }
button, a, summary { -webkit-tap-highlight-color: transparent; }
button:focus-visible, a:focus-visible, summary:focus-visible { outline: 2px solid currentColor; outline-offset: 7px; }
::selection { background: var(--blue); color: var(--cream); }
.wrap { width: min(1728px, calc(100% - 8vw)); margin-inline: auto; }
.eyebrow { font: 10px var(--mono); letter-spacing: 1.4px; }
/* ── Site Header (for work.html and other subpages) ──────────── */
.site-header { height: 90px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
.wordmark { font-size: 42px; letter-spacing: -3px; font-weight: 800; display: inline-flex; align-items: center; line-height: 1; }
.logo-record { width: 24px; height: 24px; border-radius: 50%; margin: 6px 0 0 6px; background: radial-gradient(circle, var(--cream) 0 2px, var(--blue) 3px 6px, var(--cream) 7px 8px, var(--blue) 9px); }
.site-header nav { display: flex; gap: 32px; font-size: 12px; }
.site-header nav a { position: relative; padding-block: 10px; }
.site-header nav a::after { content: ''; position: absolute; left: 0; right: 100%; bottom: 4px; height: 1px; background: currentColor; transition: right .2s; }
.site-header nav a:hover::after { right: 0; }
.sound-toggle { display: flex; align-items: center; gap: 10px; background: none; padding: 12px 0 12px 12px; font: 9px var(--mono); }
.sound-bars { display: flex; align-items: center; gap: 3px; height: 18px; }
.sound-bars i { width: 2px; height: 7px; background: currentColor; }
.sound-bars i:nth-child(2) { height: 17px; }
.sound-bars i:nth-child(3) { height: 12px; }
.sound-bars i:nth-child(4) { height: 5px; }
.sound-toggle[aria-pressed=true] .sound-bars i { animation: equalizer .6s ease-in-out infinite alternate; }
.sound-toggle[aria-pressed=true] .sound-bars i:nth-child(2) { animation-delay: -.3s; }
.sound-toggle[aria-pressed=true] .sound-bars i:nth-child(3) { animation-delay: -.15s; }

/* ── Dedicated Album Showcase Page (work.html) ─────────────────── */
.page-work {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--blue);
  color: var(--cream);
}
.page-work .site-header {
  border-bottom: 1px solid color-mix(in srgb, var(--cream) 20%, transparent);
  color: var(--cream);
}
.page-work .wordmark {
  color: var(--cream);
}
.page-work .logo-record {
  background: radial-gradient(circle, var(--blue) 0 2px, var(--cream) 3px 6px, var(--blue) 7px 8px, var(--cream) 9px);
}
.page-work .nav-back-reel {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 18px;
  border-radius: 999px;
  border: 1.5px solid color-mix(in srgb, var(--cream) 40%, transparent);
  color: var(--cream);
  font: 700 11px/1 var(--mono);
  letter-spacing: 1.5px;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 0.25s cubic-bezier(.22, 1, .36, 1);
}
.page-work .nav-back-reel:hover {
  background: var(--cream);
  color: var(--blue);
  transform: translateY(-1px);
}
.page-work main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.page-work .work-section {
  padding-top: 24px;
  padding-bottom: 36px;
  background: transparent;
}
.page-work .section-heading h1 {
  font: clamp(52px, 6vw, 76px)/1 var(--serif);
  letter-spacing: -1.8px;
  margin: 0;
  color: var(--cream);
}
.page-work .footer {
  border-top: 1px solid color-mix(in srgb, var(--cream) 18%, transparent);
  color: color-mix(in srgb, var(--cream) 65%, transparent);
  padding-block: 22px;
  font: 11px var(--mono);
  letter-spacing: 1px;
}
.page-work .footer a {
  color: var(--cream);
  text-decoration: none;
}
.page-work .footer a:hover {
  text-decoration: underline;
}

/* ── Scroll Animation Hero ─────────────────────────────────────── */
.scroll-hero {
  position: relative;
  height: 420vh;
  background: var(--cream);
}

.scroll-hero__sticky {
  position: sticky;
  top: 0;
  height: 100vh;
  width: 100%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--cream);
}

.scroll-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  z-index: 1;
}

.scroll-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
}

.scroll-text {
  position: absolute;
  transition: opacity .35s ease, transform .45s cubic-bezier(.22, 1, .36, 1);
  will-change: opacity, transform;
}

/* Intro Text Overlay - Pinned to Top Left */
.scroll-text--intro {
  left: 6vw;
  top: 48px;
  max-width: min(560px, 88vw);
  pointer-events: auto;
  opacity: 1;
}

.hero-tagline-small {
  font: 700 clamp(10px, 1.1vw, 13px)/1 var(--mono);
  letter-spacing: 2.2px;
  text-transform: uppercase;
  color: var(--blue-mid);
  white-space: nowrap;
  margin: 0 0 14px 2px;
}

.hero-name-big {
  font: clamp(52px, 7.8vw, 108px)/0.9 var(--serif);
  letter-spacing: -3px;
  font-weight: 400;
  color: var(--blue);
  white-space: nowrap;
  margin: 0 0 8px 0;
}

.hero-role-big {
  font: italic clamp(42px, 6.2vw, 84px)/0.95 var(--serif);
  letter-spacing: -1.8px;
  color: var(--blue-dark);
  margin: 0;
}

/* End Text Overlay - Clean Center Play Button */
.scroll-text--end {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
}

.canvas-play-hitbox {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: clamp(140px, 16vw, 240px);
  aspect-ratio: 1;
  border-radius: 50%;
  background: transparent;
  border: none;
  padding: 0;
  cursor: pointer;
  pointer-events: auto;
  display: block;
  transition: transform .25s cubic-bezier(.22, 1, .36, 1);
}

.canvas-play-hitbox:hover {
  transform: translate(-50%, -50%) scale(1.06);
}

.canvas-play-hitbox:active {
  transform: translate(-50%, -50%) scale(0.96);
}

.play-pulse-ring {
  position: absolute;
  inset: -12px;
  border-radius: 50%;
  border: 2.5px solid color-mix(in srgb, var(--cream) 55%, transparent);
  animation: pulse-ring 2.4s cubic-bezier(.22, 1, .36, 1) infinite;
  pointer-events: none;
  transition: border-color .2s ease, transform .25s ease;
}

@keyframes pulse-ring {
  0% { transform: scale(0.95); opacity: 0.8; }
  60% { transform: scale(1.18); opacity: 0; }
  100% { transform: scale(1.18); opacity: 0; }
}

.canvas-play-hitbox:hover .play-pulse-ring {
  border-color: var(--cream);
  animation-duration: 1.2s;
}

/* Floating Scroll Indicator */
.scroll-indicator {
  position: absolute;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  font: 9px var(--mono);
  letter-spacing: 2px;
  color: var(--blue);
  pointer-events: none;
  transition: opacity .35s ease, transform .35s ease;
}

.scroll-mouse {
  width: 20px;
  height: 32px;
  border: 1.5px solid currentColor;
  border-radius: 12px;
  display: flex;
  justify-content: center;
  padding-top: 5px;
}

.scroll-wheel {
  width: 2px;
  height: 6px;
  background: currentColor;
  border-radius: 2px;
  animation: scroll-bob 1.8s cubic-bezier(.65, 0, .35, 1) infinite;
}

@keyframes scroll-bob {
  0% { transform: translateY(0); opacity: 1; }
  60% { transform: translateY(10px); opacity: 0; }
  61% { transform: translateY(0); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

/* Minimalist Progress Line */
.scroll-progress {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: color-mix(in srgb, var(--blue) 12%, transparent);
  z-index: 3;
}

.scroll-progress-fill {
  height: 100%;
  width: 0%;
  background: var(--blue);
  transition: width 0.05s linear;
}
.work-section { padding-top: 45px; padding-bottom: 75px; background: var(--blue); color: var(--cream); }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; }
h2 { font: 70px/1 var(--serif); letter-spacing: -1.8px; margin: 0; }
.portfolio-link { display: block; flex: 0 0 clamp(290px, 32vw, 490px); width: clamp(290px, 32vw, 490px); padding: 8px; border-radius: 3px; }
.album-stage { position: relative; isolation: isolate; padding-top: 30%; }
.album-vinyl { position: absolute; top: 23.08%; left: 6%; width: 88%; aspect-ratio: 1; border-radius: 50%; background: conic-gradient(from 35deg, transparent, var(--line) 45deg, transparent 80deg, transparent 180deg, var(--line) 225deg, transparent 260deg), repeating-radial-gradient(circle, var(--blue-dark) 0 2px, var(--blue) 3px, var(--blue-dark) 4px); border: 2px solid var(--blue-dark); box-shadow: 0 4px 9px var(--shadow); display: grid; place-items: center; transition: transform .6s cubic-bezier(.22, 1, .36, 1); }
.album-vinyl-label { position: relative; width: 39%; aspect-ratio: 1; border-radius: 50%; background: var(--cream); color: var(--blue); display: grid; place-items: center; transition: transform .65s cubic-bezier(.22, 1, .36, 1); }
.album-vinyl-label::after { content: ''; position: absolute; width: 7px; height: 7px; border: 2px solid var(--blue); background: var(--cream); border-radius: 50%; }
.album-vinyl-label strong { font: italic 55px/.9 var(--serif); }
.poster-cover { position: relative; z-index: 1; width: 100%; aspect-ratio: 1; background: var(--blue); color: var(--cream); padding: 24px; display: flex; flex-direction: column; justify-content: space-between; border-radius: 2px; box-shadow: 0 3px 0 var(--blue-mid), 0 8px 15px var(--shadow); transition: transform .45s cubic-bezier(.22, 1, .36, 1), box-shadow .45s; overflow: hidden; }
.poster-cover > span:not(.cover-star) { font: 7px var(--mono); letter-spacing: 1px; }
.poster-cover strong { font: clamp(60px, 6.8vw, 94px)/.8 var(--serif); letter-spacing: -2px; z-index: 1; }
.poster-cover em { color: var(--blue-light); }
.cover-star { position: absolute; right: -15px; bottom: 25px; font-size: 160px; color: var(--blue-mid); transform: rotate(10deg); transition: transform .65s; }
.portfolio-copy { padding-top: 40px; }
.portfolio-copy h3 { font: 78px/.95 var(--serif); letter-spacing: -1.5px; margin: 20px 0 30px; }
.album-cta { display: inline-flex; align-items: center; gap: 50px; border-bottom: 1px solid var(--line); padding-bottom: 10px; font-size: 12px; }
.album-cta > span { font-size: 24px; transition: transform .25s; }
.portfolio-link:focus-visible .album-vinyl { transform: translateY(-34%); }
.portfolio-link:focus-visible .album-vinyl-label { transform: rotate(-35deg); }
.portfolio-link:focus-visible .poster-cover { transform: translateY(-3px) rotate(-2deg); }
.about-section { display: grid; grid-template-columns: 1fr 1fr; gap: 100px; padding-block: 65px 90px; border-top: 1px solid var(--line); }
.about-copy h2 { margin-top: 22px; }
.about-copy p { font-size: 14px; line-height: 1.85; max-width: 350px; margin: 25px 0 20px; }
.about-location { font: 9px var(--mono); }
.about-details { padding-top: 20px; }
.about-details details { border-bottom: 1px solid var(--line); }
.about-details summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 15px; padding-block: 21px; cursor: pointer; font-size: 14px; }
.about-details summary::-webkit-details-marker { display: none; }
.about-details summary > span { font-size: 22px; transition: transform .2s; }
.about-details details[open] summary > span { transform: rotate(45deg); }
.about-details summary:hover { color: var(--blue-dark); }
.detail-content { margin: 0; padding: 0 0 23px; }
.skill-list { display: flex; flex-wrap: wrap; gap: 8px; }
.skill-list > span { padding: 8px 10px; border: 1px solid var(--line); font-size: 11px; border-radius: 2px; }
.education { display: grid; gap: 20px; }
.education h3 { font-size: 12px; font-weight: 500; margin: 0 0 6px; }
.education p { font-size: 11px; line-height: 1.7; margin: 0; }
.language-list { list-style: none; display: flex; flex-wrap: wrap; gap: 20px; font-size: 12px; }
.contact-section { background: var(--blue); color: var(--cream); }
.contact-inner { padding-block: 65px; position: relative; }
.contact-section h2 { font-size: 85px; margin: 25px 0 30px; }
.email-row { display: flex; align-items: center; gap: 15px; position: relative; width: fit-content; max-width: 100%; }
.contact-email { font-size: 17px; display: flex; gap: 20px; align-items: center; padding-block: 10px; }
.contact-email > span { transition: transform .2s; }
.contact-email:hover > span { transform: translate(3px, -3px); }
.contact-email:hover { text-decoration: underline; text-underline-offset: 5px; }
.copy-email { width: 36px; height: 36px; flex-shrink: 0; border: 1px solid color-mix(in srgb, var(--cream) 35%, transparent); border-radius: 50%; background: transparent; display: grid; place-items: center; transition: background .2s, color .2s; }
.copy-email svg { width: 17px; height: 17px; }
.copy-email:hover { background: var(--cream); color: var(--blue); }
#copy-status { position: absolute; top: 100%; right: 0; font: 9px var(--mono); }
.contact-phones { display: flex; flex-wrap: wrap; gap: 25px; font-size: 11px; font-style: normal; margin-top: 30px; }
.contact-phones span { font: 8px var(--mono); margin-right: 6px; color: var(--blue-light); }
.contact-phones a:hover { text-decoration: underline; text-underline-offset: 4px; }
.footer { display: flex; justify-content: space-between; align-items: center; padding-block: 26px; font: 9px var(--mono); }
.footer a > span { display: inline-block; margin-left: 6px; transition: transform .2s; }
.footer a:hover > span { transform: translateY(-3px); }
.skip-link { position: fixed; top: -60px; left: 20px; background: var(--blue); color: var(--cream); padding: 15px; z-index: 100; }
.skip-link:focus { top: 10px; }
.is-paused { animation-play-state: paused !important; }
@keyframes record-spin { to { transform: rotate(360deg); } }
@keyframes equalizer { to { transform: scaleY(.35); } }

/* ============================================================
   ON RECORD POP-UP MODAL (FULL SHEET OVERLAY)
   ============================================================ */
.record-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s ease;
}

.record-modal.is-open {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.record-modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(15, 34, 58, 0.72);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  opacity: 0;
  transition: opacity 0.4s ease;
}

.record-modal.is-open .record-modal__backdrop {
  opacity: 1;
}

.record-modal__container {
  position: relative;
  width: 100%;
  height: 100%;
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
  background: var(--cream);
  transform: translateY(100%);
  transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
}

.record-modal.is-open .record-modal__container {
  transform: translateY(0);
}

/* Modal Header */
.modal-header {
  position: sticky;
  top: 0;
  z-index: 70;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 6vw;
  background: color-mix(in srgb, var(--cream) 92%, transparent);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--line);
}

.modal-nav {
  display: flex;
  gap: 32px;
  font: 11px var(--mono);
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.modal-nav-link {
  color: var(--blue);
  text-decoration: none;
  transition: color 0.2s, opacity 0.2s;
  padding-block: 4px;
}

.modal-nav-link:hover {
  color: var(--blue-mid);
}

.modal-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.modal-close-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 18px;
  border-radius: 999px;
  border: 1.5px solid var(--blue);
  background: transparent;
  color: var(--blue);
  font: 700 10px var(--mono);
  letter-spacing: 1.5px;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(.22, 1, .36, 1);
}

.modal-close-btn .close-icon {
  font-size: 11px;
  line-height: 1;
  transition: transform 0.25s ease;
}

.modal-close-btn:hover {
  background: var(--blue);
  color: var(--cream);
  transform: translateY(-1px);
  box-shadow: 0 4px 12px var(--shadow);
}

.modal-close-btn:hover .close-icon {
  transform: rotate(90deg);
}

.modal-content {
  flex: 1;
}

.back-to-reel-btn {
  background: transparent;
  border: none;
  font: inherit;
  color: inherit;
  cursor: pointer;
  text-decoration: underline;
  text-underline-offset: 4px;
  transition: color 0.2s, transform 0.2s;
}

.back-to-reel-btn:hover {
  color: var(--blue-mid);
  transform: translateY(-2px);
}

@media (hover: hover) and (pointer: fine) {
  .portfolio-link:hover .album-vinyl { transform: translateY(-34%); }
  .portfolio-link:hover .album-vinyl-label { transform: rotate(-35deg); }
  .portfolio-link:hover .poster-cover { transform: translateY(-3px) rotate(-2deg); box-shadow: 0 4px 0 var(--blue-mid), 0 12px 20px var(--shadow); }
  .portfolio-link:hover .cover-star { transform: rotate(65deg); }
  .portfolio-link:hover .album-cta > span { transform: translate(4px, -4px); }
}
@media (hover: none) { .album-vinyl { transform: translateY(-20%); } }
@media (max-width: 1100px) {
  .wrap { width: calc(100% - 72px); }
  .scroll-text--intro { left: 5vw; }
  .scroll-text--mid { right: 5vw; }
  .portfolio-link { gap: 50px; padding-inline: 45px; }
  .portfolio-copy h3 { font-size: 65px; }
  .poster-cover { padding: 16px; }
  .poster-cover strong { font-size: 48px; }
  .cover-star { font-size: 130px; }
  .about-section { gap: 60px; }
}
