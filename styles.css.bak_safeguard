  padding-top: 6px;
  font-family: var(--mono, 'Space Mono', monospace);
  font-size: 8px;
  color: color-mix(in srgb, var(--blue, #336196) 50%, transparent);
}

/* Sound Toggle Button */
.sound-toggle-btn {
  position: fixed;
  top: 28px;
  right: 36px;
  z-index: 200;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  border: 1px solid color-mix(in srgb, var(--blue, #336196) 25%, transparent);
  border-radius: 999px;
  padding: 6px 14px;
  color: var(--blue, #336196);
  font-family: var(--mono, 'Space Mono', monospace);
  font-size: 11px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
.sound-toggle-btn:hover {
  background: color-mix(in srgb, var(--blue, #336196) 8%, transparent);
  border-color: var(--blue, #336196);
  transform: translateY(-1px);
}
.sound-toggle-label {
  font-weight: 700;
}

/* Empty Category Desk Notice */
.empty-category-desk-badge {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 15;
  pointer-events: auto;
}

.empty-category-stamp {
  background: var(--cream, #fff7ed);
  border: 2px dashed rgba(51, 97, 150, 0.4);
  border-radius: 8px;
  padding: 32px 42px;
  text-align: center;
  box-shadow: 0 16px 36px rgba(10, 25, 55, 0.28);
  max-width: 440px;
}

.empty-category-tag {
  font-family: var(--mono, 'Space Mono', monospace);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 2px;
  color: var(--blue, #336196);
  background: color-mix(in srgb, var(--blue, #336196) 12%, transparent);
  padding: 4px 10px;
  border-radius: 999px;
  display: inline-block;
  margin-bottom: 12px;
}

.empty-category-title {
  margin: 0 0 10px 0;
  font-family: var(--serif, 'Instrument Serif', Georgia, serif);
  font-size: 28px;
  color: var(--blue, #336196);
  letter-spacing: -0.5px;
}

.empty-category-text {
  margin: 0 0 8px 0;
  font-family: var(--mono, 'Space Mono', monospace);
  font-size: 11px;
  color: color-mix(in srgb, var(--blue, #336196) 80%, transparent);
}

.empty-category-code {
  display: inline-block;
  font-family: var(--mono, 'Space Mono', monospace);
  font-size: 12px;
  font-weight: 700;
  color: var(--blue, #336196);
  background: rgba(51, 97, 150, 0.08);
  padding: 6px 14px;
  border-radius: 4px;
  margin-bottom: 12px;
  border: 1px solid rgba(51, 97, 150, 0.2);
}

.empty-category-hint {
  margin: 0;
  font-family: var(--sans, 'Inter', sans-serif);
  font-size: 11.5px;
  color: color-mix(in srgb, var(--blue, #336196) 70%, transparent);
}

/* Body & View Stages */
body.page-reel {
  background-color: var(--cream, #fff7ed);
  overflow-x: hidden;
}

/* Postcard Desk Stage Blue Background */
.react-album-stage.is-postcard-stage {
  background-color: transparent !important;
}

body.page-work.is-showcase-active {
  background-color: transparent !important;
}

@media (max-width: 640px) {
  .draggable-postcard-item {
    width: min(340px, 88vw) !important;
    height: calc(min(340px, 88vw) * 9 / 16) !important;
    margin-left: 0 !important;
    margin-top: 0 !important;
  }
  .clean-back-btn {
    top: max(20px, env(safe-area-inset-top, 20px));
    left: max(20px, env(safe-area-inset-left, 20px));
    padding: 8px 16px;
  }
}

/* Clean Album Hover (Zero Edge Highlights or Outlines) */
.react-album-card-link,
.react-album-card-link:hover,
.react-album-card-link:focus,
.react-album-card-item:hover,
.tilted-card-figure:hover,
.tilted-card-inner:hover {
  outline: none !important;
  border: none !important;
  box-shadow: none !important;
}

.typographic-album-jacket,
.typographic-album-jacket.has-icon,
.jacket-cover-icon {
  outline: none !important;
  border: none !important;
  box-shadow: none !important;
}

.tilted-card-back {
  background: transparent !important;
  box-shadow: none !important;
  border: none !important;
  outline: none !important;
}

/* Front Album Cover Icon Artwork */
.jacket-cover-icon {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  display: block !important;
  border-radius: inherit;
  user-select: none;
  -webkit-user-drag: none;
}


/* Uncluttered focus when a postcard is expanded */
.scattered-envelopes-wrapper.has-expanded-card .draggable-postcard-item:not(.is-expanded) {
  opacity: 0.12 !important;
  filter: blur(4px) !important;
  pointer-events: none !important;
  transition: opacity 0.35s ease, filter 0.35s ease !important;
}

.draggable-postcard-item.is-expanded {
  z-index: 250 !important;
}

.scattered-envelopes-wrapper.has-expanded-card {
  z-index: 200 !important;
}
