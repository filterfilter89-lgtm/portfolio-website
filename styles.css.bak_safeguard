/* ============================================================
   ALBUM CAROUSEL STAGE & TRACK (WORK PAGE)
   ============================================================ */

.page-work {
  min-height: 100vh;
  width: 100vw;
  height: 100vh;
  margin: 0;
  padding: 0;
  background-color: var(--cream) !important;
  color: var(--blue);
  overflow: hidden !important;
}

.page-work #root {
  width: 100%;
  height: 100%;
  overflow: hidden;
  position: relative;
  background-color: transparent !important;
  z-index: 60;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  user-select: none;
}

.react-album-stage {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;
  touch-action: none;
  cursor: default;
  background-color: transparent !important;
  box-shadow: none;
  z-index: 20;
}

.react-album-track {
  position: absolute;
  top: calc(50% - 10px);
  left: 50%;
  width: 0;
  height: 0;
  pointer-events: none;
}

.react-album-card-item {
  position: absolute;
  top: 0;
  left: 0;
  pointer-events: auto;
  will-change: transform;
  contain: layout style;
  transform: translateZ(0);
  transform-style: preserve-3d;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: opacity 0.36s cubic-bezier(0.22, 1, 0.36, 1);
}

.react-album-card-item.is-fading-out,
.react-album-card-item.is-fading-out-left {
  opacity: 0 !important;
  pointer-events: none !important;
  transform: translate(-50%, -50%) translate3d(calc(var(--card-dx) - 130vw), var(--card-dy), 0) rotate(calc(var(--card-rot) - 20deg)) !important;
  transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.45s ease !important;
}

.react-album-card-item.is-fading-out-right {
  opacity: 0 !important;
  pointer-events: none !important;
  transform: translate(-50%, -50%) translate3d(calc(var(--card-dx) + 130vw), var(--card-dy), 0) rotate(calc(var(--card-rot) + 20deg)) !important;
  transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.45s ease !important;
}

.react-album-card-item.is-selected-descending {
  z-index: 10 !important;
  transform: translate(-50%, -50%) translate3d(var(--card-dx), 130vh, 0) rotate(0deg) !important;
  opacity: 0 !important;
  transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.55s ease !important;
  pointer-events: none;
}

.react-album-card-item.is-selected-ascending {
  z-index: 30 !important;
  transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease !important;
}

.react-album-card-item.is-selected-dipped {
  z-index: 100 !important;
  transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}

/* ============================================================
   FERRIS WHEEL ENTRANCE & EXIT KEYFRAME ANIMATIONS
   ============================================================ */
@keyframes albumSlideInLeft {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) translate3d(calc(var(--card-dx) - 540px), calc(var(--card-dy) + 160px), 0) rotate(calc(var(--card-rot) - 22deg)) scale(0.85);
  }
  100% {
    opacity: 1;
    transform: translate(-50%, -50%) translate3d(var(--card-dx), var(--card-dy), 0) rotate(var(--card-rot)) scale(1);
  }
}

@keyframes albumSlideInRight {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) translate3d(calc(var(--card-dx) + 540px), calc(var(--card-dy) + 160px), 0) rotate(calc(var(--card-rot) + 22deg)) scale(0.85);
  }
  100% {
    opacity: 1;
    transform: translate(-50%, -50%) translate3d(var(--card-dx), var(--card-dy), 0) rotate(var(--card-rot)) scale(1);
  }
}

@keyframes albumSlideOutLeft {
  0% {
    opacity: 1;
    transform: translate(-50%, -50%) translate3d(var(--card-dx), var(--card-dy), 0) rotate(var(--card-rot)) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -50%) translate3d(calc(var(--card-dx) - 540px), calc(var(--card-dy) + 160px), 0) rotate(calc(var(--card-rot) - 22deg)) scale(0.85);
  }
}

@keyframes albumSlideOutRight {
  0% {
    opacity: 1;
    transform: translate(-50%, -50%) translate3d(var(--card-dx), var(--card-dy), 0) rotate(var(--card-rot)) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -50%) translate3d(calc(var(--card-dx) + 540px), calc(var(--card-dy) + 160px), 0) rotate(calc(var(--card-rot) + 22deg)) scale(0.85);
  }
}

.react-album-card-item.is-entering-from-left {
  animation: albumSlideInLeft 0.72s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.react-album-card-item.is-entering-from-right {
  animation: albumSlideInRight 0.72s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.react-album-card-item.is-exiting-to-reel-left {
  animation: albumSlideOutLeft 0.42s cubic-bezier(0.36, 0, 0.66, -0.56) forwards;
  pointer-events: none !important;
}

.react-album-card-item.is-exiting-to-reel-right {
  animation: albumSlideOutRight 0.42s cubic-bezier(0.36, 0, 0.66, -0.56) forwards;
  pointer-events: none !important;
}


