  .modal-nav { display: none; }
  .modal-close-btn { padding: 6px 12px; font-size: 9px; }
  .scroll-indicator { bottom: 18px; font-size: 8px; }
  .work-section { padding-top: 30px; padding-bottom: 50px; }
  h2 { font-size: 57px; }
  .section-heading { margin-bottom: 23px; }
  .section-heading .eyebrow { font-size: 8px; }
  .portfolio-link { grid-template-columns: 1fr; gap: 25px; padding: 20px 30px 30px; }
  .album-stage { width: min(520px, 100%); justify-self: center; }
  .poster-cover { padding: 14px; }
  .poster-cover strong { font-size: clamp(42px, 10vw, 65px); }
  .poster-cover > span:not(.cover-star) { font-size: 5px; }
  .album-vinyl-label strong { font-size: 32px; }
